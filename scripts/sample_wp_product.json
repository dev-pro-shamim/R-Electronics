  "excerpt": {
    "rendered": "<div class=\"flex mt-1 text-sm\">\n<div class=\"font-semibold w-28\">Model:</div>\n<p>MX GE3750</p></div>\n<div class=\"pt-2 pb-1 reset-list-style\">\n<ul>\n<li>Rust-resistant SS strong jars &amp; blades</li>\n<li>3 Stainless Steel Jars</li>\n<li>Safety Child Lock</li>\n</ul>\n<table class=\"jsx-2030750473 border-collapse border border-gray-500 w-full\">\n<tbody class=\"jsx-2030750473\">\n<tr class=\"jsx-2030750473 border-collapse border border-gray-300 w-full\">\n<td id=\"td-1\" class=\"jsx-2030750473  font-bold  w-1/6 text-base tab-sm:text-lg\" rowspan=\"1\">General Features</td>\n<td class=\"jsx-2030750473 border-collapse border border-gray-300 font-bold w-2/6 text-sm tab-sm:text-base\">Resistance</td>\n<td class=\"jsx-2030750473 w-3/6 text-sm tab-sm:text-base\">Rust Resistant SS strong jars &amp; blades</td>\n</tr>\n<tr class=\"jsx-2030750473 border-collapse border border-gray-300 w-full\">\n<td id=\"td-1\" class=\"jsx-2030750473  font-bold  w-1/6 text-base tab-sm:text-lg\" rowspan=\"1\">Program</td>\n<td class=\"jsx-2030750473 border-collapse border border-gray-300 font-bold w-2/6 text-sm tab-sm:text-base\">Hygiene</td>\n<td class=\"jsx-2030750473 w-3/6 text-sm tab-sm:text-base\">No-Gasket, Easy to clean lids for better hygiene</td>\n</tr>\n<tr class=\"jsx-2030750473 border-collapse border border-gray-300 w-full\">\n<td id=\"td-1\" class=\"jsx-2030750473  font-bold  w-1/6 text-base tab-sm:text-lg\" rowspan=\"2\">Motor</td>\n<td class=\"jsx-2030750473 border-collapse border border-gray-300 font-bold w-2/6 text-sm tab-sm:text-base\">RPM</td>\n<td class=\"jsx-2030750473 w-3/6 text-sm tab-sm:text-base\">High Performance 19000 RPM</td>\n</tr>\n<tr class=\"jsx-2030750473 border-collapse border border-gray-300 w-full\">\n<td class=\"jsx-2030750473 border-collapse border border-gray-300 font-bold w-2/6 text-sm tab-sm:text-base\">Air Flow</td>\n<td class=\"jsx-2030750473 w-3/6 text-sm tab-sm:text-base\">High Power Air Flow Motor</td>\n</tr>\n<tr class=\"jsx-2030750473 border-collapse border border-gray-300 w-full\">\n<td id=\"td-1\" class=\"jsx-2030750473  font-bold  w-1/6 text-base tab-sm:text-lg\" rowspan=\"2\">Features</td>\n<td class=\"jsx-2030750473 border-collapse border border-gray-300 font-bold w-2/6 text-sm tab-sm:text-base\">Motor Power</td>\n<td class=\"jsx-2030750473 w-3/6 text-sm tab-sm:text-base\">Powerful 1200W (Max) Motor Capacity</td>\n</tr>\n<tr class=\"jsx-2030750473 border-collapse border border-gray-300 w-full\">\n<td class=\"jsx-2030750473 border-collapse border border-gray-300 font-bold w-2/6 text-sm tab-sm:text-base\">Jar Capacity</td>\n<td class=\"jsx-2030750473 w-3/6 text-sm tab-sm:text-base\">Blender Jar: 1.5L || Mill Jar: 1.0L || Chutney Jar: 0.4L</td>\n</tr>\n<tr class=\"jsx-2030750473 border-collapse border border-gray-300 w-full\">\n<td id=\"td-1\" class=\"jsx-2030750473  font-bold  w-1/6 text-base tab-sm:text-lg\" rowspan=\"1\">Lock</td>\n<td class=\"jsx-2030750473 border-collapse border border-gray-300 font-bold w-2/6 text-sm tab-sm:text-base\">Safety Lock System</td>\n<td class=\"jsx-2030750473 w-3/6 text-sm tab-sm:text-base\">Easy Lid-Safety Lock</td>\n</tr>\n</tbody>\n</table>\n<p>5 Years Motor</p>\n<p>1 Year Electric Spare Parts &amp; 1 Years Service</p>\n</div>\n",
