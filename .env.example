# ==========================================
# RANGO ELECTRONICS - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. SITE & CORE APPLICATION URL
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rangoelectronics.com

# ------------------------------------------
# 2. SUPABASE (DATABASE & AUTH)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------
# 3. ADMIN & CUSTOMER SESSION SECRETS
# ------------------------------------------
# Default credentials for Admin login
ADMIN_EMAIL=admin@rangoelectronics.com
ADMIN_PASSWORD=YourStrongAdminPassword
# Random 32+ character strings for cookie encryption
ADMIN_SESSION_SECRET=create_a_random_long_secret_key_32_chars_min
CUSTOMER_SESSION_SECRET=create_another_random_secret_key_32_chars_min

# ------------------------------------------
# 4. GOOGLE OAUTH LOGIN (Customer Auth)
# ------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------
# 5. CLOUDINARY (Product Image & Media Upload)
# ------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------
# 6. EMAIL & NOTIFICATIONS (Order Confirmation / Alerts)
# ------------------------------------------
ADMIN_NOTIFICATION_EMAIL=admin@rangoelectronics.com
# Option A: SMTP (Gmail / cPanel Webmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
# Option B: Resend (Alternative to SMTP)
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------
# 7. COURIER API INTEGRATIONS (1-Click Booking)
# ------------------------------------------
# Steadfast Courier (Only API Key & Secret Key needed)
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# Pathao Courier
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_username
PATHAO_PASSWORD=your_pathao_password
PATHAO_STORE_ID=your_pathao_store_id
PATHAO_BASE_URL=https://api-hermes.pathao.com

# RedX Courier
REDX_API_TOKEN=your_redx_api_token
REDX_STORE_ID=your_redx_store_id
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta

# Paperfly (Optional)
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
PAPERFLY_API_KEY=
PAPERFLY_BASE_URL=

# ------------------------------------------
# 8. MARKETING, ANALYTICS & SMS (Optional)
# ------------------------------------------
META_CAPI_ACCESS_TOKEN=
SMS_API_KEY=
